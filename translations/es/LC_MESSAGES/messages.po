"El plan necesita unos %(needs)s, pero debe terminar antes de %(end)s "
"(dentro de %(left)s)"

#: app/sky.py:288 static/js/interface-guide.js:151
msgid "Never rises from this telescope's site"
msgstr "Nunca sale sobre el horizonte desde el lugar de este telescopio"

#: app/sky.py:290
msgid "Below the horizon now"
msgstr "Ahora está bajo el horizonte"

