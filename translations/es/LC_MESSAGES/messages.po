msgstr "Tu código 2FA es %(code)s. Introdúcelo para completar el inicio de sesión."

#: controllers/auth.py:141
msgid "Check your email for the 2FA code to complete the login."
msgstr ""
"Revisa tu correo electrónico: te hemos enviado el código 2FA para "
"completar el inicio de sesión."

#: controllers/auth.py:145
msgid "Invalid credentials, please try again."
msgstr "Credenciales no válidas. Inténtalo de nuevo."

#: controllers/auth.py:161
msgid "Logged out successfully"
msgstr "Has cerrado sesión correctamente"

#: controllers/auth.py:176 templates/register.html:30
msgid "Please complete the CAPTCHA before creating your account."
msgstr "Completa el CAPTCHA antes de crear tu cuenta."

#: controllers/auth.py:185
msgid "You must agree to the Terms of Service to create an account."
msgstr "Debes aceptar las Condiciones del servicio para crear una cuenta."

#: controllers/auth.py:193
msgid "Username and email already taken. Please choose another two."
msgstr "El nombre de usuario y el correo electrónico ya están en uso. Elige otros."

#: controllers/auth.py:197
msgid "Username already taken. Please choose another one."
msgstr "Ese nombre de usuario ya está en uso. Elige otro."

#: controllers/auth.py:201
msgid "Email already used. Please choose another one."
msgstr "Ese correo electrónico ya está en uso. Elige otro."

#: controllers/auth.py:214
msgid "Account created and logged in successfully!"
msgstr "¡Cuenta creada y sesión iniciada correctamente!"

#: controllers/auth.py:238 templates/forgot_password.html:21
msgid "Please complete the CAPTCHA before requesting a reset link."
msgstr "Completa el CAPTCHA antes de solicitar el enlace de restablecimiento."

#: controllers/auth.py:255
#, python-format
msgid "Password reset token (local connection): %(token)s"
msgstr "Token para restablecer la contraseña (conexión local): %(token)s"

#: controllers/auth.py:256
msgid "Use this token to access the reset link directly."
msgstr "Usa este token para acceder directamente al enlace de restablecimiento."

#: controllers/auth.py:265
msgid "Password Reset Request"
msgstr "Solicitud de restablecimiento de contraseña"

#: controllers/auth.py:265
#, python-format
msgid "Click the following link to reset your password: %(url)s"
msgstr "Haz clic en el siguiente enlace para restablecer tu contraseña: %(url)s"

#: controllers/auth.py:266
msgid "A password reset link has been sent to your email."
msgstr ""
"Te hemos enviado un enlace para restablecer la contraseña a tu correo "
"electrónico."

#: controllers/auth.py:268
#, python-format
msgid "Error sending email: %(error)s"
msgstr "Error al enviar el correo electrónico: %(error)s"

#: controllers/auth.py:273
msgid "No account found with that email address."
msgstr "No hay ninguna cuenta con ese correo electrónico."

#: controllers/auth.py:289
msgid "That is an invalid or expired token."
msgstr "El token no es válido o ha caducado."

#: controllers/auth.py:299
msgid "Your password has been updated!"
msgstr "¡Tu contraseña se ha actualizado!"

#: controllers/auth.py:312
msgid "Session expired. Please log in again."
msgstr "La sesión ha caducado. Vuelve a iniciar sesión."

#: controllers/auth.py:335
#, python-format
msgid "Login successful! Device \"%(device)s\" is now trusted for 30 days."
msgstr ""
"¡Sesión iniciada! El dispositivo «%(device)s» será de confianza durante "
"30 días."

#: controllers/auth.py:341
msgid "Login successful!"
msgstr "¡Sesión iniciada!"

#: controllers/auth.py:348
msgid "Invalid 2FA code. Please try again."
msgstr "Código 2FA no válido. Inténtalo de nuevo."

#: controllers/auth.py:365
msgid "Device trust revoked successfully."
msgstr "Se ha retirado la confianza del dispositivo."

#: controllers/auth.py:367
msgid "Device not found or could not be revoked."
msgstr "No se ha encontrado el dispositivo o no se ha podido retirar la confianza."

