msgid "The sky isn't fully dark yet"
msgstr "El cielo todavía no está del todo oscuro"

#: app/sky.py:299
msgid "Fairly low; it gets better nearer its transit"
msgstr "Bastante bajo; mejora cerca de su tránsito"

#: app/sky.py:299
msgid "Fairly low and sinking"
msgstr "Bastante bajo y bajando"

#: app/sky.py:300
msgid "Good conditions for this target"
msgstr "Buenas condiciones para este objetivo"

