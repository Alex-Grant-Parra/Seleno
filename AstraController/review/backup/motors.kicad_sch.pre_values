	(text "Shared single-wire UART: R16 1k from ESP32 TX; U7 addr 0 (MS1=0), U8 addr 1 (MS1=1).\nSet microsteps over UART (U8 standalone would be 1/32).\nR35/R36 hold ENN high so drivers are OFF while the ESP32 boots.\nRsense 0.15R 1206 0.5W -> 1.35A RMS max. J1/J2: coil A = pins 1-3, coil B = 4-6.\nLayout: thermal vias under U7/U8, short separate sense-resistor GND returns."
		(exclude_from_sim no)
		(at 140 45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8f9a25b8-1ff3-4437-8c35-f37088fda242")
	)
	(embedded_fonts no)
